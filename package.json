  "keywords": [
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "react-router",
    "axios",
    "vitest",
    "dashboard",
    "jsonplaceholder"
  ],
  "author": "Osman Can Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmncnylmz/hana-author-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/osmncnylmz/hana-author-dashboard/issues"
  },
  "homepage": "https://github.com/osmncnylmz/hana-author-dashboard#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
